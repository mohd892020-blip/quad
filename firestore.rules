rules_version = '2';
// The world High Score board (src/online.js). Paste into Firebase console > Firestore Database > Rules, then Publish.
// Each player owns one document named by their anonymous id, holding only a nickname and a score. Anyone may read the
// board; a player may write or remove only their own document, the score never goes down, and the name follows the same
// rule as checkName in src/online.js: English letters, digits and spaces, at least one letter, none of the worst words. Keep the numbers in step with ONLINE in src/config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('[A-Za-z0-9 ]{3,16}')
        && request.resource.data.name.matches('.*[A-Za-z].*')
        && !request.resource.data.name.lower().replace(' ', '').matches('.*(fuck|fuk|shit|cunt|bitch|nigger|nigga|faggot|whore|slut|pussy|porn|asshole|kosomak|kusomak|sharmo|sharmu|manyak).*')
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && (resource == null || request.resource.data.score >= resource.data.score);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
